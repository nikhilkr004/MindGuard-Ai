<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivConsentShield"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_shield_check"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvConsentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Safety &amp; Clinical Disclaimer"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivConsentShield" />

        <!-- Disclaimer Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tvConsentTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Important Notice"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MindGuard AI is an early mental health screening and teleconsultation navigation platform. It does NOT provide formal medical or psychiatric diagnoses.\n\nAll AI assessments are indicative screening metrics intended to guide discussions with licensed healthcare professionals."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Crisis Helpline Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCrisis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/crisis_banner"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/crisis_border"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@+id/cardDisclaimer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency &amp; Crisis Support"
                    android:textColor="@color/crisis_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="If you or someone you know is in immediate distress or crisis, please call emergency services (911 / 988 Suicide &amp; Crisis Lifeline) or Tele-MANAS (14416) immediately."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.25" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Checkbox 1 -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:buttonTint="@color/primary"
            android:text="I understand that MindGuard AI is a screening tool, not a diagnostic medical device."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/cardCrisis" />

        <!-- Checkbox 2 -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:buttonTint="@color/primary"
            android:text="I agree to on-device AI analysis and the Privacy Policy &amp; Terms of Service."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/cbDisclaimer" />

        <ProgressBar
            android:id="@+id/consentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbPrivacy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptConsent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:enabled="false"
            android:text="I Understand &amp; Continue"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/consentProgress" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
