<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Header -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Sensory Grounding"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressGrounding"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="20dp"
            android:progress="20"
            app:trackCornerRadius="3dp"
            app:trackColor="@color/surface_2"
            app:indicatorColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Step 1 of 5"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressGrounding" />

        <!-- Active Exercise Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStepContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border"
            app:cardBackgroundColor="@color/surface_light"
            app:layout_constraintTop_toBottomOf="@+id/tvStepIndicator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvSenseCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 THINGS YOU SEE"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvStepInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Look around the room. Notice 5 objects around you that you wouldn't usually pay attention to."
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/tvStepExamples"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Examples: The texture of the wall, light reflecting off a surface, a pen on the desk, a shadow in the corner, the clock."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <LinearLayout
                    android:id="@+id/llCheckboxes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbItem1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="First item noticed"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />

                    <CheckBox
                        android:id="@+id/cbItem2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Second item noticed"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />

                    <CheckBox
                        android:id="@+id/cbItem3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Third item noticed"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />

                    <CheckBox
                        android:id="@+id/cbItem4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Fourth item noticed"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />

                    <CheckBox
                        android:id="@+id/cbItem5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Fifth item noticed"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation Buttons -->
        <LinearLayout
            android:id="@+id/llNavButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/cardStepContent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevStep"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Previous"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:cornerRadius="16dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_border"
                android:backgroundTint="@color/surface_2"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStep"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:layout_marginStart="8dp"
                android:text="Next Sense →"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- Completion Card (Initially Hidden) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompletion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/success"
            app:cardBackgroundColor="@color/surface_light"
            app:layout_constraintTop_toBottomOf="@+id/tvStepIndicator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Grounding Complete"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="You have anchored your awareness in the present reality. Take a deep breath and carry this calmness forward."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinishGrounding"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Return to Calming Zone"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
