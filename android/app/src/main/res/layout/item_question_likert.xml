<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvQuestionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Question 1"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Over the last 2 weeks, how often have you felt down, depressed, or hopeless?"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2" />

        <!-- 5-point Likert Options RadioGroup -->
        <RadioGroup
            android:id="@+id/rgLikertOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbOption0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="0 — Never"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/rbOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="1 — Rarely (A few days)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/rbOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="2 — Sometimes (More than half the days)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/rbOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="3 — Often (Nearly every day)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />

            <RadioButton
                android:id="@+id/rbOption4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="4 — Almost Always (Intense daily impact)"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:buttonTint="@color/primary" />
        </RadioGroup>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
